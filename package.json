{
  "name": "subnetlab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IPv4/IPv6 planning, IPAM, and subnetting practice for students and administrators.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "node --watch src/server/sqlite-app.js",
    "db:init": "node src/server/init-db.js",
    "test": "node --test",
    "check": "node --check src/server/index.js && node --check src/server/sqlite-app.js && node --check src/server/supabase-app.js && node --check public/app.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
