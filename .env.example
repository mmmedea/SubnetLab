PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000

# Optional for local SQLite development. Vercel should use Supabase instead.
DB_PATH=./data/subnetlab.sqlite

# Required for the deployed Supabase backend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-server-only-supabase-secret-key

# Next.js Supabase Auth (public browser-safe values)
NEXT_PUBLIC_SUPABASE_URL=https://jfqgttbnmubhzaqzlzjo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Legacy fallback, only if using the anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
